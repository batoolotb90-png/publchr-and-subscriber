!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist


class TurtleCircle(Node):
    def __init__(self):
        super().__init__('turtle_circle')
        self.publisher_ = self.create_publisher(Twist, '/turtle1/cmd_vel', 10)
        # Send commands every 0.1 seconds
        self.timer = self.create_timer(0.1, self.move_circle)
        self.get_logger().info('Turtle Circle node started! Turtle will move in a circle.')

    def move_circle(self):
        msg = Twist()
        # Linear speed (forward)
        msg.linear.x = 1.0
        # Angular speed (turning) - controls the circle radius
        # radius = linear.x / angular.z
        # radius = 1.0 / 0.5 = 2.0 units
        msg.angular.z = 0.5
        self.publisher_.publish(msg)

    def stop_turtle(self):
        msg = Twist()
        msg.linear.x = 0.0
        msg.angular.z = 0.0
        self.publisher_.publish(msg)


def main(args=None):
    rclpy.init(args=args)
    node = TurtleCircle()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        node.get_logger().info('Stopping turtle...')
        node.stop_turtle()
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()